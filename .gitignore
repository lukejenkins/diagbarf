# diagbarf is a C project — build products are built on demand via `make` and
# are not tracked. (A `#` only starts a comment at column 0 in .gitignore, so
# each pattern gets its own line with the comment above it.)

# ── Built binaries ───────────────────────────────────────────────────────────
# device: static armv7l hard-float
/diagbarf
# host: static x86-64
/diagbarf-x86_64
# host: static aarch64 jump box
/diagbarf-aarch64

# ── C build intermediates ────────────────────────────────────────────────────
*.o
*.a
*.so
*.lo
*.d
*.obj
# gcov / profiling
*.gcno
*.gcda
*.gcov

# ── Test binaries (keep the .c sources, ignore the compiled tests) ───────────
/tests/test_*
!/tests/test_*.c
!/tests/*.h

# ── Core dumps / debug ───────────────────────────────────────────────────────
core
core.*
vgcore.*
*.dSYM/

# ── Editor / OS cruft ────────────────────────────────────────────────────────
*.swp
*.swo
*~
.DS_Store
